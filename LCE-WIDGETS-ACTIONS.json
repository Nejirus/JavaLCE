  "ports": [
    "Minecraft.cpp context prompts use held-item fallbacks before block/entity overrides.",
    "UIController gates gameplay for ten presented frames; 1.9.4 corrects the earlier game-tick interpretation after inspecting the platform loop/input library.",
    "IUIScene_AbstractContainerMenu maps Square/X to standard right-click half/one actions.",
    "FJ_CheckBox toggles once per confirm press and draws its original tick bitmap.",
    "UIScene_SettingsUIMenu uses the three original HUD sizes, labelled 1 through 3.",
    "HD world setup uses the original mode button, difficulty slider, horizontal pack list, and More Options seed field."
  ]
}
