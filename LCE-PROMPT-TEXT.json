  "ports": [
    "UIController::SetupFont installs UIBitmapFont instead of the SWF fallback outline font.",
    "CFontData: 23x20 cells, 8x13 pixels, alpha-only masks, advance from the rightmost opaque pixel and 5px whitespace.",
    "UIBitmapFont::GetGlyphBitmap: source scale 2 at 720p and 3 at 1080p, therefore one atlas pixel per automatic GUI unit.",
    "IUIScene_CraftingMenu::handleKeyDown/UpdateTooltips: Square cycles Inventory, Description, Ingredients; no Craft All or Craftable controller actions.",
    "Original Tile/Item setUseDescriptionId bindings and strings.resx texts; no replacement descriptions are written."
  ],
  "adaptations": [
    "Tooltip text is centered by its actual source bitmap ink bounds within each original controller glyph frame, instead of using a Flash TextField origin as Java ink coordinates.",
    "The original two-source-pixel TextField inset is retained; the original font atlas adds its own one-pixel leading bearing. Existing text colours remain.",
    "Java-specific recipes without a corresponding original LCE use-description stay blank, following the source release fallback.",
    "Keyboard/mouse batch crafting and keyboard recipe filtering remain optional Java shortcuts; controller prompts and bindings follow LCE."
  ]
}
